# KEEP ON SERVER ONLY. Never put Serper key into the Android app.
SERPER_API_KEY=Insert Serper API Key
# Make using: python -c "import secrets;print(secrets.token_urlsafe(32))"
PLOTWATCH_APP_TOKEN=change_to_a_very_long_random_token
# Set /data on Railway with a persistent volume mounted there.
PLOTWATCH_DATA_DIR=./data
